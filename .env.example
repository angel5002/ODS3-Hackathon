# Copiar como .env.local. NUNCA subir .env.local a GitHub (el repositorio es público).
# Las líneas marcadas [USTEDES] las completan ustedes; las marcadas [CLAUDE CODE] las completa la ejecución 0.

# Nombre del producto
NEXT_PUBLIC_APP_NAME="AsistIA"

# [USTEDES] PIN para entrar al panel, tablero y controles de demo (4-6 dígitos)
DEMO_PIN=

# [USTEDES] Supabase: token personal (supabase.com > Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=

# [CLAUDE CODE] Supabase: se completan al crear o enlazar el proyecto
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [USTEDES] Vercel: token personal (vercel.com > Account Settings > Tokens)
VERCEL_TOKEN=

# [USTEDES] Gemini API (aistudio.google.com > Get API key). Solo se usa en el servidor. Ejecución 2.
GEMINI_API_KEY=
