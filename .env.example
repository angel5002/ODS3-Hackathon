# Copiar como .env.local. NUNCA subir .env.local a GitHub.
NEXT_PUBLIC_APP_NAME="AsistIA"
DEMO_PIN=
PUBLIC_BASE_URL=

# Supabase
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel
VERCEL_TOKEN=

# Gemini (respaldo de voz)
GEMINI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_TOOL_SECRET=
ELEVENLABS_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Sesiones del chat
CHAT_SESSION_SECRET=
# Máximo de llamadas de voz simultáneas (plan Creator: 10; dejamos 2 de margen para las pruebas)
VOICE_MAX_CONCURRENT=8
# Transporte de la voz: webrtc (por defecto: cancelación de eco y búfer de red del navegador) o websocket (plan B)
VOICE_TRANSPORT=webrtc
